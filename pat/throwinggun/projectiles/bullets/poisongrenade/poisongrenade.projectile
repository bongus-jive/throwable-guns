{
  "projectileName": "pat_throwingpoisonlauncher_grenade",
  "image": "poisongrenade.png",
  "physics": "grenade",
  "emitters": [ "pat_throwingpoisonlauncher_trail" ],
  "flippable": true,
  "speed": 58,
  "timeToLive": 3,
  "damageType": "NoDamage",
  "damageKind": "default",
  "damagePoly": [ [ 3, 3 ], [ 3, -3 ], [ -3, -3 ], [ -3, 3 ] ],

  "actionOnReap": [
    {
      "action": "projectile",
      "type": "poisonexplosionknockback",
      "inheritDamageFactor": 1,
      "fuzzAngle": 360,
      "config": {
        "knockback": 15,
        "bounces": -1
      }
    },
    { "action": "projectile", "type": "pat_throwingpoisonlauncher_cloud", "offsetRange": [ -0.5, -0.5, 0.5, 0.5 ], "fuzzAngle": 45, "angleAdjust": 0 },
    { "action": "projectile", "type": "pat_throwingpoisonlauncher_cloud", "offsetRange": [ -0.5, -0.5, 0.5, 0.5 ], "fuzzAngle": 45, "angleAdjust": 90 },
    { "action": "projectile", "type": "pat_throwingpoisonlauncher_cloud", "offsetRange": [ -0.5, -0.5, 0.5, 0.5 ], "fuzzAngle": 45, "angleAdjust": 180 },
    { "action": "projectile", "type": "pat_throwingpoisonlauncher_cloud", "offsetRange": [ -0.5, -0.5, 0.5, 0.5 ], "fuzzAngle": 45, "angleAdjust": 270 },
    { "action": "projectile", "type": "pat_throwingpoisonlauncher_cloud", "offsetRange": [ -0.5, -0.5, 0.5, 0.5 ], "fuzzAngle": 360 },
    { "action": "projectile", "type": "pat_throwingpoisonlauncher_cloud", "offsetRange": [ -0.5, -0.5, 0.5, 0.5 ], "fuzzAngle": 360, "inheritSpeedFactor": 0 },
    {
      "action": "loop",
      "count": 12,
      "body": [
        { "action": "projectile", "type": "pat_throwingpoisonlauncher_trail", "fuzzAngle": 360 },
        { "action": "particle", "specification": "pat_throwingpoisonlauncher_gassy" }
      ]
    },
    {
      "action": "sound",
      "options": [ "/sfx/gun/grenadeblast_poison1.ogg", "/sfx/gun/grenadeblast_poison2.ogg", "/sfx/gun/grenadeblast_poison3.ogg" ]
    },
    {
      "action": "sound",
      "options": [ "/sfx/projectiles/poisonorb_break1.ogg", "/sfx/projectiles/poisonorb_break2.ogg" ]
    },
    {
      "action": "sound",
      "options": [ "/sfx/npc/boss/guardian_floorhazard_poison.ogg" ]
    },
    {
      "action": "explosion",
      "foregroundRadius": 2,
      "backgroundRadius": 0,
      "explosiveDamageAmount": 0.5,
      "delaySteps": 2
    }
  ]
}

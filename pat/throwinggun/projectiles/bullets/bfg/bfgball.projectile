{
  "projectileName": "pat_throwingbfg_ball",
  "image": "bfgball.png",
  "physics": "laser",
  "animationCycle": 0.4,
  "frameNumber": 4,
  "speed": 60,
  "timeToLive": 2.5,
  "fullbright": true,
  "flippable": false,
  "orientationLocked": true,
  "lightColor": [ 67, 140, 47 ],
  "damagePoly": [ [ -12, 0 ], [ -8, -8 ], [ 0, -12 ], [ 8, -8 ], [ 12, 0 ], [ 8, 8 ], [ 0, 12 ], [ -8, 8 ] ],
  "damageType": "NoDamage",

  "scripts": [ "bfgball.lua" ],
  "maxTargets": 5,
  "queryRange": 60,
  "queryOptions": { "order": "random", "includedTypes": [ "creature" ] },
  "tracerProjectile": "pat_throwingbfg_tracer",
  "tracerRadius": 2.5,

  "actionOnReap": [
    {
      "action": "projectile",
      "type": "pat_throwingbfg_explosion",
      "fuzzAngle": 360,
      "inheritDamageFactor": 1
    }
  ],

  "periodicActions": [
    {
      "time": 0.02,
      "repeat": true,
      "action": "loop",
      "count": 2,
      "body": [
        {
          "action": "option",
          "options": [
            { "action": "spark" },
            {
              "action": "particle",
              "rotate": true,
              "specification": {
                "type": "ember",
                "layer": "back",
                "size": 3,
                "fullbright": true,
                "color": [ 47, 255, 87 ],
                "destructionAction": "shrink",
                "destructionTime": 0.5,
                "collidesForeground": false,
                "initialVelocity": [ 30, 0 ],
                "finalVelocity": [ 30, 0 ],
                "approach": [ -40, -40 ],
                "variance": {
                  "size": 1.5,
                  "timeToLive": 0.1,
                  "initialVelocity": [ 10, 10 ],
                  "finalVelocity": [ 20, 20 ]
                }
              }
            },
            {
              "action": "particle",
              "rotate": true,
              "specification": {
                "type": "ember",
                "layer": "back",
                "size": 2,
                "fullbright": true,
                "color": [ 186, 255, 123 ],
                "destructionAction": "shrink",
                "destructionTime": 0.5,
                "collidesForeground": false,
                "initialVelocity": [ 30, 0 ],
                "finalVelocity": [ 30, 0 ],
                "approach": [ -40, -40 ],
                "variance": {
                  "size": 1,
                  "timeToLive": 0.1,
                  "initialVelocity": [ 10, 10 ],
                  "finalVelocity": [ 20, 20 ]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
